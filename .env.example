# Postgres — same teller_app role and schema as the main repo. Point this at
# the SAME database if you want one shared audit trail, or a fresh one for
# an isolated trial.
TELLER_DATABASE_URL=

# Xero — one (entity, mode) pair minimum. Matches src/adapters/xero.ts's
# creds() lookup exactly: XERO_{ENTITY}_{MODE}_CLIENT_ID / _CLIENT_SECRET.
# Fallback used if entity-specific ones are unset:
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Auth for this deployment. See netlify/functions/mcp.mts's own header before
# setting these — a shared secret is a PoC-grade gate, not real identity.
# Whoever holds TELLER_SHARED_SECRET calls the API as TELLER_MCP_PRINCIPAL,
# which must exist in src/core/policy.ts's PRINCIPALS map.
TELLER_SHARED_SECRET=
TELLER_MCP_PRINCIPAL=

# Roll-forward stays off on Netlify - no local file, no Python runtime.
# Leaving TELLER_TRACKER_FILE unset makes it a no-op, same as locally.
